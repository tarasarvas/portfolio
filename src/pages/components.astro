---
/**
 * Living style guide — a single page that shows every design token and
 * component. This is your lightweight "Storybook": edit a component or a
 * token and this page reflects it automatically. Not linked in the public
 * nav — just visit /components. (You can delete this file anytime; it does
 * not affect the real site.)
 */
import '../styles/global.css';
import '../styles/case-study.css';
import Button from '../components/Button.astro';
import SkillCard from '../components/SkillCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import YouTube from '../components/YouTube.astro';

const colors = [
  { name: 'Ink', var: '--color-ink' },
  { name: 'Ink soft', var: '--color-ink-soft' },
  { name: 'Ink secondary', var: '--color-ink-secondary' },
  { name: 'Background', var: '--color-bg' },
  { name: 'Background muted', var: '--color-bg-muted' },
  { name: 'Surface', var: '--color-surface' },
  { name: 'Border', var: '--color-border' },
  { name: 'Red', var: '--color-red' },
  { name: 'Red soft', var: '--color-red-soft' },
  { name: 'Blue', var: '--color-blue' },
  { name: 'Blue ink', var: '--color-blue-ink' },
  { name: 'Blue bg', var: '--color-blue-bg' },
  { name: 'Alice blue', var: '--color-blue-alice' },
  { name: 'Green', var: '--color-green' },
  { name: 'Green ink', var: '--color-green-ink' },
  { name: 'Green bg', var: '--color-green-bg' },
  { name: 'Yellow', var: '--color-yellow' },
  { name: 'Yellow ink', var: '--color-yellow-ink' },
  { name: 'Yellow bg', var: '--color-yellow-bg' },
  { name: 'Navy', var: '--color-navy' },
  { name: 'Purple', var: '--color-purple' },
  { name: 'Icon tile', var: '--color-icon-tile' },
];

const fonts = [
  { name: 'Hind', role: 'Headings', token: '--font-heading', value: "'Hind', sans-serif" },
  { name: 'Open Sans', role: 'Body', token: '--font-body', value: "'Open Sans', sans-serif" },
];

const type = [
  { label: 'Heading 1', token: '--text-h1', size: '64px', family: 'Hind', familyVar: 'var(--font-heading)', weight: 700 },
  { label: 'Heading 2', token: '--text-h2', size: '42px', family: 'Hind', familyVar: 'var(--font-heading)', weight: 700 },
  { label: 'Heading 3', token: '--text-h3', size: '24px', family: 'Hind', familyVar: 'var(--font-heading)', weight: 600 },
  { label: 'Body', token: '--text-body', size: '21px', family: 'Open Sans', familyVar: 'var(--font-body)', weight: 400 },
  { label: 'Small', token: '--text-small', size: '18px', family: 'Open Sans', familyVar: 'var(--font-body)', weight: 400 },
  { label: 'ProductBody', token: '--text-product-body', size: '15px', family: 'Open Sans', familyVar: 'var(--font-body)', weight: 400 },
  { label: 'ProductBodySemiBold', token: '--text-product-body-semibold', size: '15px', family: 'Open Sans', familyVar: 'var(--font-body)', weight: 600 },
  { label: 'ProductSmallBody', token: '--text-product-small', size: '13px', family: 'Open Sans', familyVar: 'var(--font-body)', weight: 400 },
  { label: 'ProductSmallBodySemiBold', token: '--text-product-small-semibold', size: '13px', family: 'Open Sans', familyVar: 'var(--font-body)', weight: 600 },
];

const spacing = [
  { name: '2', token: '--space-2', value: '2px' },
  { name: '4', token: '--space-4', value: '4px' },
  { name: '8', token: '--space-8', value: '8px' },
  { name: '12', token: '--space-12', value: '12px' },
  { name: '16', token: '--space-16', value: '16px' },
  { name: '20', token: '--space-20', value: '20px' },
  { name: '24', token: '--space-24', value: '24px' },
  { name: '32', token: '--space-32', value: '32px' },
  { name: '48', token: '--space-48', value: '48px' },
  { name: '64', token: '--space-64', value: '64px' },
  { name: '80', token: '--space-80', value: '80px' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Style Guide · Taras Sarvas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hind:wght@300;400;500;600;700&family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="sg-body">
    <header class="sg-header">
      <div class="sg-wrap">
        <h1 class="sg-title">Design System</h1>
        <p class="sg-lead">
          Every token and component used across the site. This page uses the real code, so it stays
          in sync automatically. Change a value in <code>tokens.css</code> or a component and it updates here.
        </p>
        <nav class="sg-toc">
          <a href="#colors">Colors</a>
          <a href="#type">Typography</a>
          <a href="#spacing">Spacing</a>
          <a href="#buttons">Buttons</a>
          <a href="#cards">Cards</a>
          <a href="#callouts">Callouts</a>
          <a href="#media">Media</a>
          <a href="#layout">Layout pieces</a>
        </nav>
      </div>
    </header>

    <main class="sg-wrap">
      <!-- COLORS -->
      <section id="colors" class="sg-section">
        <h2 class="sg-h2">Colors</h2>
        <p class="sg-note">Defined in <code>src/styles/tokens.css</code>. Use as <code>var(--color-ink)</code>.</p>
        <div class="sg-swatches">
          {colors.map((c) => (
            <div class="sg-swatch">
              <div class="sg-chip" style={`background:var(${c.var})`}></div>
              <div class="sg-swatch-name">{c.name}</div>
              <code class="sg-swatch-var">{c.var}</code>
            </div>
          ))}
        </div>
      </section>

      <!-- TYPOGRAPHY -->
      <section id="type" class="sg-section">
        <h2 class="sg-h2">Typography</h2>
        <p class="sg-note">Defined in <code>src/styles/tokens.css</code>.</p>

        <h3 class="sg-h3">Font families</h3>
        <div class="sg-meta-grid">
          {fonts.map((f) => (
            <div class="sg-meta-card">
              <div class="sg-meta-sample" style={`font-family:${f.value};font-size:28px;font-weight:600`}>Aa</div>
              <div class="sg-meta-name">{f.name}</div>
              <div class="sg-meta-detail">{f.role}</div>
              <code>{f.token}</code>
              <code class="sg-meta-value">{f.value}</code>
            </div>
          ))}
        </div>

        <h3 class="sg-h3">Font sizes</h3>
        <div class="sg-stack">
          {type.map((t) => (
            <div class="sg-type-row">
              <div class="sg-type-meta">
                <span class="sg-type-label">{t.label}</span>
                <span class="sg-type-specs">
                  <code>{t.size}</code>
                  <code>{t.family}</code>
                  <code>weight {t.weight}</code>
                  <code>{t.token}</code>
                </span>
              </div>
              <span style={`font-family:${t.familyVar};font-size:${t.size};font-weight:${t.weight};line-height:1.2`}>
                The quick brown fox
              </span>
            </div>
          ))}
        </div>
      </section>

      <!-- SPACING -->
      <section id="spacing" class="sg-section">
        <h2 class="sg-h2">Spacing scale</h2>
        <p class="sg-note">Defined in <code>src/styles/tokens.css</code>. Use as <code>var(--space-md)</code>.</p>
        <div class="sg-stack">
          {spacing.map((s) => (
            <div class="sg-space-row">
              <code class="sg-space-name">{s.token}</code>
              <code class="sg-space-value">{s.value}</code>
              <div class="sg-space-bar" style={`width:${s.value}`}></div>
            </div>
          ))}
        </div>
      </section>

      <!-- BUTTONS -->
      <section id="buttons" class="sg-section">
        <h2 class="sg-h2">Buttons <span class="sg-file">Button.astro</span></h2>
        <p class="sg-note">One component, three variants. Restyle every button via the <code>--button-*</code> tokens. Press scales to 98%.</p>
        <div class="sg-row">
          <div class="sg-specimen">
            <Button demo variant="tertiary">Product</Button>
            <span class="sg-cap">tertiary</span>
          </div>
          <div class="sg-specimen">
            <Button demo variant="secondary">Product</Button>
            <span class="sg-cap">secondary</span>
          </div>
          <div class="sg-specimen">
            <Button demo variant="primary">Product</Button>
            <span class="sg-cap">primary</span>
          </div>
        </div>
      </section>

      <!-- CARDS -->
      <section id="cards" class="sg-section">
        <h2 class="sg-h2">Cards</h2>

        <h3 class="sg-h3">Skill card <span class="sg-file">SkillCard.astro</span></h3>
        <div class="sg-row" style="max-width:640px">
          <div style="width:220px"><SkillCard icon="/images/UI.svg" label="Simple & intuitive UI" /></div>
          <div style="width:220px"><SkillCard icon="/images/AI.svg" label="AI infused designs" /></div>
        </div>

        <h3 class="sg-h3">Project card <span class="sg-file">ProjectCard.astro</span></h3>
        <div class="small-card-section" style="padding:0">
          <div class="w-layout-grid card-grid" style="margin:0">
            <ProjectCard
              href="/oak9"
              title="DevOps Canvas for oak9"
              subtitle="Visualize security of cloud infrastructure"
              image="/images/oak9.png"
            />
          </div>
        </div>
      </section>

      <!-- CALLOUTS -->
      <section id="callouts" class="sg-section">
        <h2 class="sg-h2">Callout blocks</h2>
        <p class="sg-note">CSS classes used inside case studies: <code>.block</code>, <code>.block.insights</code>, <code>.interview-block</code>, <code>.warning-block</code>.</p>
        <div class="sg-callouts">
          <div class="block" style="margin:0;max-width:none">
            <h2 class="quote-text" style="font-size:24px">“A customer quote lives here.”</h2>
            <p class="quote-author">- Someone important</p>
          </div>
          <div class="block insights" style="margin:0;max-width:none">
            <h2 class="quote-text insights" style="font-size:24px">An insight or takeaway.</h2>
          </div>
          <div class="interview-block" style="margin:0;max-width:none;width:auto">
            <h2 class="interview-header" style="font-size:24px">Interview</h2>
            <p class="interview-text">A note from a user interview.</p>
          </div>
          <div class="warning-block" style="margin:0;max-width:none">
            <h2 class="warning-header" style="font-size:24px">⚠️ A warning or constraint.</h2>
          </div>
        </div>
      </section>

      <!-- MEDIA -->
      <section id="media" class="sg-section">
        <h2 class="sg-h2">YouTube embed <span class="sg-file">YouTube.astro</span></h2>
        <div style="max-width:640px">
          <YouTube id="2JMYGK6HbT8" title="Sample video" caption="Responsive 16:9 embed" />
        </div>
      </section>

      <!-- LAYOUT PIECES -->
      <section id="layout" class="sg-section">
        <h2 class="sg-h2">Layout pieces</h2>
        <p class="sg-note">These need a full page to demo, so here's what they do and where to see them live:</p>
        <ul class="sg-list">
          <li><strong>Navbar.astro</strong> — top navigation. Live on every page.</li>
          <li><strong>Footer.astro</strong> — site footer. Live on every page.</li>
          <li><strong>BaseLayout.astro / CaseStudyLayout.astro</strong> — page shells (head tags, fonts, nav, footer).</li>
          <li><strong>StickyScroll.astro</strong> — the scroll-driven story blocks. See <a href="/oak9">/oak9</a> or <a href="/about">/about</a>.</li>
          <li><strong>PasswordGate.astro</strong> — client-side password gate (currently unused; we'll do gating in Cloudflare).</li>
        </ul>
      </section>
    </main>

    <footer class="sg-footer sg-wrap">
      <p>Internal style guide · not linked from the public site.</p>
    </footer>

    <style>
      .sg-body { background: var(--color-bg-muted); color: var(--color-ink); margin: 0; }
      .sg-wrap { max-width: 1000px; margin: 0 auto; padding: 0 24px; }
      .sg-header { background: var(--color-surface); border-bottom: 1px solid var(--color-border); padding: 48px 0 32px; }
      .sg-title { font-family: var(--font-heading); font-size: 48px; margin: 0 0 12px; }
      .sg-lead { font-size: 18px; max-width: 640px; color: var(--color-ink-soft); font-weight: 400; }
      .sg-toc { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 20px; }
      .sg-toc a { font-size: 14px; font-weight: 600; text-decoration: none; color: var(--color-ink); border-bottom: 2px solid var(--color-icon-tile); }
      .sg-section { padding: 48px 0; border-bottom: 1px solid var(--color-border); }
      .sg-h2 { font-family: var(--font-heading); font-size: 28px; margin: 0 0 8px; display: flex; align-items: center; gap: 12px; }
      .sg-h3 { font-family: var(--font-heading); font-size: 20px; margin: 32px 0 12px; display: flex; align-items: center; gap: 10px; }
      .sg-note { font-size: 15px; color: var(--color-ink-soft); font-weight: 400; margin: 0 0 20px; }
      .sg-file { font-family: monospace; font-size: 12px; background: var(--color-icon-tile); color: var(--color-purple); padding: 2px 8px; border-radius: 6px; font-weight: 600; }
      code { font-family: monospace; font-size: 0.85em; background: #eceaf6; padding: 1px 5px; border-radius: 4px; }

      .sg-swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 16px; }
      .sg-swatch { display: flex; flex-direction: column; gap: 4px; }
      .sg-chip { height: 64px; border-radius: 10px; border: 1px solid var(--color-border); }
      .sg-swatch-name { font-size: 14px; font-weight: 600; }
      .sg-swatch-var { font-size: 11px; }

      .sg-meta-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-bottom: 8px; }
      .sg-meta-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 12px; padding: 16px; display: flex; flex-direction: column; gap: 6px; }
      .sg-meta-sample { line-height: 1; color: var(--color-ink); }
      .sg-meta-name { font-size: 16px; font-weight: 600; }
      .sg-meta-detail { font-size: 13px; color: var(--color-ink-soft); font-weight: 400; }
      .sg-meta-value { font-size: 11px; word-break: break-all; }

      .sg-stack { display: flex; flex-direction: column; gap: 20px; }
      .sg-type-row { display: flex; flex-direction: column; gap: 6px; }
      .sg-type-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; }
      .sg-type-label { font-size: 13px; font-weight: 600; color: var(--color-ink); min-width: 88px; }
      .sg-type-specs { display: flex; flex-wrap: wrap; gap: 6px; }

      .sg-space-row { display: flex; align-items: center; gap: 16px; }
      .sg-space-name { width: 120px; }
      .sg-space-value { width: 48px; font-weight: 600; }
      .sg-space-bar { height: 16px; background: var(--color-purple); border-radius: 4px; }

      .sg-row { display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start; }
      .sg-specimen { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
      .sg-cap, .sg-caption { font-family: monospace; font-size: 12px; color: var(--color-ink-soft); }

      .sg-callouts { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
      @media (max-width: 720px) { .sg-callouts { grid-template-columns: 1fr; } }

      .sg-list { line-height: 1.9; font-size: 16px; font-weight: 400; }
      .sg-footer { padding: 32px 0; color: var(--color-ink-soft); font-size: 14px; }
    </style>
  </body>
</html>
