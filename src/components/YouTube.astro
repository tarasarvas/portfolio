---
/** Responsive 16:9 YouTube embed. */
interface Props {
  id: string;      // YouTube video id
  title?: string;
  controls?: boolean;
  caption?: string;
}
const { id, title = 'Video', controls = true, caption } = Astro.props;
const src = `https://www.youtube.com/embed/${id}?rel=0&controls=${controls ? 1 : 0}&autoplay=0&mute=0&start=0`;
---

<div class="case-study-image-block you-tube _16-9">
  <div class="youtube-embed">
    <iframe
      src={src}
      title={title}
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>
  {caption && <div class="b2-regular gray">{caption}</div>}
</div>

<style>
  .youtube-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0;
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .youtube-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
