---
/** Responsive 16:9 YouTube embed. */
interface Props {
  id: string;      // YouTube video id
  title?: string;
  controls?: boolean;
  caption?: string;
}
const { id, title = 'Video', controls = true, caption } = Astro.props;
const src = `https://www.youtube.com/embed/${id}?rel=0&controls=${controls ? 1 : 0}&autoplay=0&mute=0&start=0`;
---

<div class="case-study-image-block you-tube _16-9">
  <div class="youtube-embed">
    <div class="youtube-embed__media">
      <iframe
        src={src}
        title={title}
        frameborder="0"
        allow="autoplay; encrypted-media"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  </div>
  {caption && <div class="b2-regular gray">{caption}</div>}
</div>

<style>
  /* Shadow lives on the outer shell — overflow:hidden on the same node would clip it
     (shadow is mostly downward: 0 4px 12px). */
  .youtube-embed {
    width: 100%;
    border-radius: var(--radius-md); /* 16px — same as .case-study-image */
    box-shadow: var(--shadow-card);
  }
  .youtube-embed__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: inherit;
    overflow: hidden;
  }
  .youtube-embed__media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
