---
/** Site footer. Used on every page. */
---

<div class="footer">
  <div class="w-layout-grid footer-grid">
    <div class="footer-card left">
      <img src="/images/Logo.png" loading="lazy" alt="Taras Sarvas logo" class="image-4" />
      <div class="footer-text">
        <p class="b2-regular">Taras Sarvas</p>
        <p class="b2-bold">tarasarvas@gmail.com</p>
      </div>
    </div>
    <div class="footer-card middle">
      <p class="b2-bold">Illustrations by Taras Sarvas © 2025</p>
    </div>
    <div class="footer-card right">
      <p class="b2-bold disappear">Follow Me:</p>
      <a href="https://www.linkedin.com/in/tarasarvas/" target="_blank" rel="noopener" class="footer-link">
        <img src="/images/Group-1.png" loading="lazy" alt="LinkedIn" />
      </a>
      <a href="https://tarasarvas.medium.com/" target="_blank" rel="noopener" class="footer-link">
        <img src="/images/Group-3.png" loading="lazy" alt="Medium" />
      </a>
      <a href="https://dribbble.com/tarasarvas" target="_blank" rel="noopener" class="footer-link">
        <img src="/images/Group-2.png" loading="lazy" alt="Dribbble" />
      </a>
    </div>
  </div>
</div>
