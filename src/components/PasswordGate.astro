---
/**
 * Client-side password gate for case-study pages.
 *
 * NOTE: Webflow's original protection was server-side (/.wf_auth). Static
 * hosts like Cloudflare Pages have no server, so this is a lightweight
 * client-side gate — it hides the page content until the password is
 * entered, and remembers the unlock for the browser session.
 *
 * This is obfuscation suitable for low-stakes gating (recruiters), NOT
 * real security: a determined visitor can read the HTML source. If you
 * ever need true protection, we can add a Cloudflare Pages Function or
 * Cloudflare Access instead.
 *
 * The password is intentionally not written in the markup; it is hashed.
 */
interface Props {
  passwordHash: string; // SHA-256 hex of the password
  gateId: string;       // unique key per page for sessionStorage
}
const { passwordHash, gateId } = Astro.props;
---

<div class="pw-gate" data-gate-id={gateId} data-hash={passwordHash}>
  <div class="pw-gate__inner">
    <h2 class="pw-gate__heading">Password Required</h2>
    <form class="pw-gate__form">
      <input
        class="pw-gate__input"
        type="password"
        autocomplete="off"
        placeholder="It's on my resume ;)"
        aria-label="Password"
      />
      <button type="submit" class="button button--primary pw-gate__submit">SUBMIT</button>
      <p class="pw-gate__error" hidden>Incorrect password. Please try again.</p>
    </form>
  </div>
</div>

<div class="pw-protected" hidden>
  <slot />
</div>

<style>
  .pw-gate {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background-color: var(--color-bg);
  }
  /* The [hidden] attribute must win over display:flex above. */
  .pw-gate[hidden] {
    display: none;
  }
  .pw-gate__inner {
    width: 100%;
    max-width: 420px;
    text-align: center;
  }
  .pw-gate__heading { text-align: center; padding-bottom: 24px; }
  .pw-gate__form { display: flex; flex-direction: column; align-items: stretch; }
  .pw-gate__input {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 16px;
    font-size: 21px;
    font-family: var(--font-body);
    font-weight: 400;
  }
  .pw-gate__submit { margin-top: 12px; padding-top: 12px; padding-bottom: 12px; }
  .pw-gate__error { color: var(--color-red); margin-top: 12px; }
</style>

<script>
  async function sha256Hex(text: string): Promise<string> {
    const data = new TextEncoder().encode(text);
    const digest = await crypto.subtle.digest('SHA-256', data);
    return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  document.querySelectorAll<HTMLElement>('.pw-gate').forEach((gate) => {
    const gateId = gate.dataset.gateId!;
    const expected = gate.dataset.hash!;
    const protectedEl = gate.nextElementSibling as HTMLElement | null;
    const form = gate.querySelector('form')!;
    const input = gate.querySelector<HTMLInputElement>('.pw-gate__input')!;
    const error = gate.querySelector<HTMLElement>('.pw-gate__error')!;
    const storageKey = `unlocked:${gateId}`;

    const reveal = () => {
      gate.hidden = true;
      if (protectedEl) protectedEl.hidden = false;
    };

    if (sessionStorage.getItem(storageKey) === '1') reveal();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const hash = await sha256Hex(input.value);
      if (hash === expected) {
        sessionStorage.setItem(storageKey, '1');
        reveal();
      } else {
        error.hidden = false;
        input.value = '';
      }
    });
  });
</script>
