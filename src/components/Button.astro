---
/**
 * Button — the single source of truth for every button/CTA on the site.
 * Change the styling in global.css (.button / .button--*) or the tokens
 * in tokens.css (--button-*) and it updates everywhere at once.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  caseStudy?: boolean; // adds case-study spacing
  gapUp?: boolean;
  target?: string;
  class?: string;
}

const {
  href,
  variant = 'secondary',
  caseStudy = false,
  gapUp = false,
  target,
  class: extraClass = '',
} = Astro.props;

const classes = [
  'button',
  `button--${variant}`,
  caseStudy ? 'button--case-study' : '',
  gapUp ? 'button--gap-up' : '',
  extraClass,
]
  .filter(Boolean)
  .join(' ');
---

<a href={href} class={classes} {...target ? { target, rel: 'noopener' } : {}}>
  <slot />
</a>
