---
/**
 * Button — the single source of truth for every button/CTA on the site.
 * Change the styling in global.css (.button / .button--*) or the tokens
 * in tokens.css (--button-*) and it updates everywhere at once.
 *
 * Pass `demo` (or href="#") for style-guide specimens — renders a <button>
 * so clicks don't navigate.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'tertiary';
  /** Non-navigating specimen for the design system page */
  demo?: boolean;
  caseStudy?: boolean; // adds case-study spacing
  gapUp?: boolean;
  target?: string;
  class?: string;
}

const {
  href = '#',
  variant = 'secondary',
  demo = false,
  caseStudy = false,
  gapUp = false,
  target,
  class: extraClass = '',
} = Astro.props;

const isDemo = demo || href === '#';

const classes = [
  'button',
  `button--${variant}`,
  caseStudy ? 'button--case-study' : '',
  gapUp ? 'button--gap-up' : '',
  extraClass,
]
  .filter(Boolean)
  .join(' ');
---

{isDemo ? (
  <button type="button" class={classes}>
    <slot />
  </button>
) : (
  <a href={href} class={classes} {...target ? { target, rel: 'noopener' } : {}}>
    <slot />
  </a>
)}
