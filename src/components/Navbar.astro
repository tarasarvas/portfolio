---
import Button from './Button.astro';

/**
 * Top navigation. Used on every page.
 * Fixed, transparent at top. Hides on scroll down, returns with frost on scroll up.
 * `current` highlights the active nav link ('work' | 'about').
 */
interface Props {
  caseStudy?: boolean;
  current?: 'work' | 'about' | null;
}
const { caseStudy = false, current = null } = Astro.props;

const contactHref = 'mailto:tarasarvas@gmail.com?subject=Loved%20Your%20Portfolio!';
---

<div role="banner" class={`navbar ${caseStudy ? 'case-study' : ''}`} id="site-navbar">
  <div class="navigation-div-block">
    <a href="/" class="brand" aria-label="Home">
      <img src="/images/Portfolio-Assets_Logo-Full-1.png" loading="lazy" alt="Taras Sarvas" height="40" />
    </a>
    <nav role="navigation" class="nav-menu" id="nav-menu">
      <Button href="/#Work" variant="tertiary" class={current === 'work' ? 'w--current' : ''}>Work</Button>
      <Button href="/about" variant="tertiary" class={current === 'about' ? 'w--current' : ''}>About</Button>
      <div class="nav-photos-cluster">
        <div class="nav-photos">
          <Button
            href="https://photos.tarasarvas.com"
            variant="tertiary"
            target="_blank"
            class="button--icon"
          >
            Photos
            <img src="/images/Share-Icon.svg" loading="lazy" width="16" height="16" alt="" />
          </Button>
        </div>
        <Button href={contactHref} variant="secondary">Contact</Button>
        <div class="nav-photos-popover" id="photos-popover" role="tooltip">
          <img
            src="/images/photos-app-logo.png"
            alt=""
            width="32"
            height="32"
            class="nav-photos-popover__logo"
          />
          <p class="nav-photos-popover__title">What is Photos Project?</p>
          <p class="nav-photos-popover__desc">
            A personal site I built with Cursor and Claude Code to keep close friends and family in the loop.
          </p>
        </div>
      </div>
    </nav>
    <button class="menu-button" id="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</div>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });

  // Hide on scroll down, show + frost on scroll up (Chrome-style).
  const navbar = document.getElementById('site-navbar');
  if (navbar) {
    let lastY = window.scrollY;
    let ticking = false;
    const TOP_THRESHOLD = 24; // near top → transparent, always visible
    const DELTA = 6; // ignore tiny jitter

    const update = () => {
      const y = window.scrollY;
      const delta = y - lastY;

      if (y <= TOP_THRESHOLD) {
        navbar.classList.remove('is-hidden', 'is-frosted');
      } else {
        navbar.classList.add('is-frosted');
        if (delta > DELTA) {
          // scrolling down → tuck away
          navbar.classList.add('is-hidden');
          menu?.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
        } else if (delta < -DELTA) {
          // scrolling up → reveal with frost
          navbar.classList.remove('is-hidden');
        }
      }

      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );

    // Set initial state (e.g. deep-linked mid-page)
    update();
  }
</script>
