---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  caseStudy?: boolean;
  current?: 'work' | 'about' | null;
  /** Set false to omit the footer (rarely needed). */
  footer?: boolean;
}

const {
  title,
  description = 'Iteration-led, ambiguity-ready product designer specializing in simple UI, research-based decisions, and AI-infused designs.',
  caseStudy = false,
  current = null,
  footer = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hind:wght@300;400;500;600;700&family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />

    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/images/webclip.png" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BQZW5PY1X9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-BQZW5PY1X9', { anonymize_ip: false });
    </script>
  </head>
  <body class={`body ${caseStudy ? 'case-study' : ''}`}>
    <Navbar caseStudy={caseStudy} current={current} />
    <main>
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>
